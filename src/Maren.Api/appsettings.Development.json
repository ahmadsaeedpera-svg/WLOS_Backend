{
  "Cors": {
    "AdminPortalOrigins": [ "http://localhost:5173", "http://localhost:5174", "http://localhost:5175" ]
  },
  "ConnectionStrings": {
    "WlosPlatform": "Server=(localdb)\\MSSQLLocalDB;Database=WlosPlatform;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=True"
  },
  "Jwt": {
    "Issuer": "wlos.platform",
    "Audience": "wlos.app",
    "SigningKey": "dev-only-signing-key-not-for-production-use-32chars",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30
  },
  "Logging": { "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning" } }
}
