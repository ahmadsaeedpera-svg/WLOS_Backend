# Maren Platform — deployment configuration
#
# Copy to .env, fill in, and keep it off every machine that does not need it.
# .gitignore refuses .env; this file is the only one of the pair that is
# committed, and it must never hold a real value.
#
#   cp .env.example .env
#   docker compose -f docker-compose.prod.yml up -d
#
# ---------------------------------------------------------------------------
# Why these are environment variables and not a file
# ---------------------------------------------------------------------------
#
# The API reads configuration through .NET's standard providers, so every key
# below maps onto a section with a DOUBLE UNDERSCORE. `Jwt__SigningKey` is
# `Jwt:SigningKey`. A single colon does not work as an environment variable
# name on Linux, which is a mistake that produces a clean start and a broken
# service rather than an error.
#
# appsettings.Development.json holds a signing key explicitly named as dev-only
# and a LocalDB connection string. .dockerignore excludes it from every image
# so it cannot travel; nothing here should ever contain its values.


# ---------------------------------------------------------------------------
# Database  — required
# ---------------------------------------------------------------------------
#
# Maps to ConnectionStrings:WlosPlatform. The name matters: Repositories.cs
# asks for "WlosPlatform" by name and throws at startup if it is absent.
#
# Azure SQL Database:
#   Server=tcp:<server>.database.windows.net,1433;Initial Catalog=WlosPlatform;
#   User ID=<user>;Password=<password>;Encrypt=True;
#   TrustServerCertificate=False;Connection Timeout=30;MultipleActiveResultSets=True
#
# SQL Server on a host you run:
#   Server=<host>,1433;Database=WlosPlatform;User Id=<user>;Password=<password>;
#   Encrypt=True;TrustServerCertificate=True;MultipleActiveResultSets=True
#
# MultipleActiveResultSets=True is not optional. SqlUnitOfWork holds one
# connection per request and Dapper reads more than one result set on it.
#
# Do NOT set TrustServerCertificate=True against Azure SQL. It turns a verified
# TLS connection into an unverified one, over the public internet, carrying
# every row of the platform.
ConnectionStrings__WlosPlatform=

# ---------------------------------------------------------------------------
# JWT  — SigningKey required, the rest strongly recommended
# ---------------------------------------------------------------------------
#
# At least 32 characters; the API refuses to start below that. Generate it,
# never invent it:
#
#   openssl rand -base64 48
#
# ROTATING THIS DOES MORE THAN INVALIDATE TOKENS. HmacKdfDecoy derives the
# decoy-salt key from it, so a rotation moves every decoy salt while real
# accounts' salts stay put — which lets anyone comparing kdf-parameters either
# side of a rotation tell registered addresses from unregistered ones. See
# docs/PLATFORM_RUNBOOK.md §3. Treat rotation as a security event.
Jwt__SigningKey=

# Issuer and audience are stamped onto every token AND checked on every token.
# Leaving them unset now falls back to the same defaults on both sides, so it
# is safe — but setting them explicitly is what makes a later change visible.
# Change one without the other and every authenticated request returns 401.
Jwt__Issuer=wlos.platform
Jwt__Audience=wlos.app

# Fifteen minutes and thirty days are the shipped defaults, and the short
# access token is deliberate: it cannot be revoked once issued, so its lifetime
# is the only bound on a stolen one. Raise it only with a reason.
# Jwt__AccessTokenMinutes=15
# Jwt__RefreshTokenDays=30

# ---------------------------------------------------------------------------
# CORS  — required if the admin portal is deployed
# ---------------------------------------------------------------------------
#
# An array, so each origin is its own indexed variable. Scheme and host, no
# trailing slash, no path.
#
# Never a wildcard. The portal sends a bearer token, and
# wildcard-with-credentials is precisely the configuration that lets any site a
# signed-in editor visits drive this API as them.
Cors__AdminPortalOrigins__0=https://portal.example.com
# Cors__AdminPortalOrigins__1=

# ---------------------------------------------------------------------------
# Reverse proxy  — required whenever anything sits in front of the API
# ---------------------------------------------------------------------------
#
# Off by default, and that is correct for a directly-exposed Kestrel:
# X-Forwarded-For is attacker-controlled input on an open port. Left off behind
# a proxy, two things quietly break and neither of them errors:
#
#   - Every audit row and every security event records the PROXY's address.
#     The IP is most of the evidence on the refusal path.
#   - The rate limiter puts every anonymous caller in one partition, so its
#     300-per-minute allowance becomes platform-wide across all sign-ins and
#     registrations. Sign-in starts returning 429 under load that is nothing.
#
# The API refuses to start if this is true and no proxy is named.
Proxy__Enabled=false

# The address the API SEES the proxy connect FROM — not the proxy's public
# address, and not the client's.
#
# NAME IT AS THE API SEES IT, WHICH MAY NOT BE THE FORM YOU EXPECT. Verified
# on 2026-09-25: an instance trusting 127.0.0.1 ignored the header completely,
# because the connection arrived on ::1 and the two are different entries. A
# wrong address here is indistinguishable from leaving this off — same audit
# rows, same rate-limit collapse, no error anywhere. Set both loopback forms
# when the proxy is on the same host.
#
# For a container behind a proxy on the host, the connection comes from the
# bridge gateway, so use KnownNetworks instead.
# Proxy__KnownProxies__0=127.0.0.1
# Proxy__KnownProxies__1=::1

# CIDR ranges, for a proxy whose address is assigned rather than chosen.
# Proxy__KnownNetworks__0=172.17.0.0/16

# How many hops back to walk. Each increment is another proxy whose claim
# about the client address is taken on trust. One unless there are genuinely
# two.
# Proxy__ForwardLimit=1

# ---------------------------------------------------------------------------
# Host  — defaults are correct for the container
# ---------------------------------------------------------------------------
#
# The image already sets both. Override ASPNETCORE_ENVIRONMENT only if you know
# why: Development turns on the Scalar API reference and detailed errors, and
# it is the one value that would make the container look for the dev-only
# appsettings file that .dockerignore keeps out of it.
# ASPNETCORE_ENVIRONMENT=Production
# ASPNETCORE_URLS=http://+:8080

# The port the API is published on, on the host. Behind a reverse proxy this
# should be bound to loopback — see docker-compose.prod.yml.
API_PORT=8080

# ---------------------------------------------------------------------------
# Not read by the API
# ---------------------------------------------------------------------------
#
# ops/db/backup.sh writes here, and this is a path ON THE SQL SERVER, not on
# the machine running the script. They are the same host for LocalDB and for a
# SQL Server container; they are not the same host once the database is managed
# or lives anywhere else, and a backup written somewhere only the client can
# see is the usual way a backup job appears to work and produces nothing.
#
# On Azure SQL Database this is meaningless: BACKUP DATABASE is not supported
# there at all, and backup/restore are the platform's, configured in Azure.
# See docs/PLATFORM_RUNBOOK.md §8.
# MAREN_BACKUP_DIR=/var/opt/mssql/backup
