# ---------------------------------------------------------------------------
# Secrets — never commit these
# ---------------------------------------------------------------------------
# appsettings.Development.json IS committed on purpose: it holds LocalDB and a
# signing key explicitly named as dev-only, so a new developer can run the API
# immediately. Every other environment's settings must stay out.
appsettings.Production.json
appsettings.Staging.json
appsettings.Local.json
*.pfx
*.p12
*.key
secrets.json
.env
.env.*
# ...except the template, which is the only list of every variable a
# deployment needs and holds no values.
!.env.example

# ---------------------------------------------------------------------------
# Test and coverage output
# ---------------------------------------------------------------------------
[Tt]est[Rr]esult*/
coverage*.json
coverage*.xml
coverage*.info
*.trx
*.coverage
*.coveragexml
BenchmarkDotNet.Artifacts/

